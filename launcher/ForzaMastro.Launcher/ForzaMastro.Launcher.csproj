<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RaceOneHub</AssemblyName><RootNamespace>ForzaMastro.Launcher</RootNamespace>
    <Version>0.1.0</Version><Authors>LoZazaMastro and contributors</Authors>
    <Product>Race One Hub</Product><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationIcon>Assets/Builder.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/Builder.png" /></ItemGroup>
</Project>
